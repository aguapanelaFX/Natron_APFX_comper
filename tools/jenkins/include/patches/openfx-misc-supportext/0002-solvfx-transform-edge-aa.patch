+    // SOLVFX: anti-aliased border (like Nuke): coverage of the output pixel by the source image,
+    // from the distance to the source bounds measured in output pixels (sharp corners: x * y coverages)
+    void setEdgeSoftness(double v)
+    {
+        _edgeSoft = v;
+    }
+
+    double solvfxEdgeCoverage(const OFX::Matrix3x3& H,
+                              const OFX::Point3D& tr,
+                              double& fx,
+                              double& fy,
+                              int x1,
+                              int x2,
+                              int y1,
+                              int y2) const
+    {
+        if ( (_edgeSoft <= 0.) || !_blackOutside || (x2 <= x1) || (y2 <= y1) ) {
+            return 1.;
+        }
+        const double z2 = tr.z * tr.z;
+        const double Jxx = (H(0,0) * tr.z - tr.x * H(2,0)) / z2;
+        const double Jxy = (H(0,1) * tr.z - tr.x * H(2,1)) / z2;
+        const double Jyx = (H(1,0) * tr.z - tr.y * H(2,0)) / z2;
+        const double Jyy = (H(1,1) * tr.z - tr.y * H(2,1)) / z2;
+        // source pixels covered by one output pixel along x and y
+        const double fpx = std::max(1e-6, std::sqrt(Jxx * Jxx + Jxy * Jxy) * _edgeSoft);
+        const double fpy = std::max(1e-6, std::sqrt(Jyx * Jyx + Jyy * Jyy) * _edgeSoft);
+        const double dx = std::min(fx - x1, x2 - fx);
+        const double dy = std::min(fy - y1, y2 - fy);
+        const double cx = std::max(0., std::min(1., 0.5 + dx / fpx));
+        const double cy = std::max(0., std::min(1., 0.5 + dy / fpy));
+        const double cov = cx * cy;
+        if (cov < 1.) {
+            // sample the nearest inside position, the coverage fades it
+            fx = std::max(x1 + 0.5, std::min(x2 - 0.5, fx));
+            fy = std::max(y1 + 0.5, std::min(y2 - 0.5, fy));
+        }
+
+        return cov;
+    }
+
     virtual FilterEnum getFilter() const = 0;
     virtual bool getClamp() const = 0;
 
