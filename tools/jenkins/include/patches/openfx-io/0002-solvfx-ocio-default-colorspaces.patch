+// SOLVFX: map a colorspace name guessed by a reader (e.g. "sRGB", "rec709", "Gamma2.2",
+// "KodakLog", "linear") to a colorspace that exists in the current config.
+string
+GenericOCIO::resolveInputColorspace(const char* name) const
+{
+#ifdef OFX_IO_USING_OCIO
+    if (!_config || !name || !*name) {
+        return name ? string(name) : string();
+    }
+    string n(name);
+    std::transform(n.begin(), n.end(), n.begin(), ::tolower);
+    // display-referred 8-bit encodings (sRGB and gamma curves, including legacy ACES names)
+    static const char* const srgbFamily[] = {
+        "srgb", "srgb8", "srgb d65", "srgb (d60 sim.)", "out_srgbd60sim", "rrt_srgb", "rrt_gamma2.2",
+        "gamma2.2", "gamma1.8", "vd16", "adobergb", NULL
+    };
+    static const char* const rec709Family[] = { "rec709", "rec.709", NULL };
+    static const char* const logFamily[] = { "kodaklog", "cineon", "log", "adx10", "redlogfilm", "lg10", "lm10", NULL };
+    static const char* const linearFamily[] = { "linear", "scene_linear", NULL };
+    struct Family { const char* const* names; const char* category; const char* role; };
+    const Family families[] = {
+        { srgbFamily, "sRGB", OCIO::ROLE_MATTE_PAINT },
+        { rec709Family, "rec709", NULL },
+        { logFamily, "KodakLog", OCIO::ROLE_COMPOSITING_LOG },
+        { linearFamily, "linear", OCIO::ROLE_SCENE_LINEAR },
+    };
+    for (size_t f = 0; f < sizeof(families) / sizeof(families[0]); ++f) {
+        for (const char* const* it = families[f].names; *it; ++it) {
+            if (n == *it) {
+                // Like Nuke: use the config's role for this kind of file when the config defines it
+                if (families[f].role) {
+                    OCIO::ConstColorSpaceRcPtr cs = _config->getColorSpace(families[f].role);
+                    if (cs) {
+                        return string( cs->getName() );
+                    }
+                }
+                if ( hasColorspace(name) ) {
+                    return string(name);
+                }
+
+                return string( colorSpaceName(_config, families[f].category) );
+            }
+        }
+    }
+    if ( hasColorspace(name) ) {
+        return string(name);
+    }
+
+    return string( colorSpaceName(_config, name) );
+#else
+
+    return name ? string(name) : string();
+#endif
+}
