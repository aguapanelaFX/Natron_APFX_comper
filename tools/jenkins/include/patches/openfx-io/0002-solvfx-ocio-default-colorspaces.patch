+// SOLVFX: return the name of the first colorspace (or role) from the list that exists in the config
+static const char*
+firstExistingColorSpace(OCIO::ConstConfigRcPtr config,
+                        const char* const* names)
+{
+    for (; *names; ++names) {
+        OCIO::ConstColorSpaceRcPtr cs = config->getColorSpace(*names);
+        if (cs) {
+            return cs->getName();
+        }
+    }
+
+    return NULL;
+}
