 #include <cmath>
 #include <iostream>
 
@@ -1526,19 +1528,96 @@ FFmpegFile::imageConvert(AVFrame* avFrameIn, AVFrame* avFrameOut)
     // Scale if any of the decoding path has provided a convert
     // context. Otherwise, no scaling/conversion is required after
     // decoding the frame.
-    if (context) {
-        sws_scale(
-            context,
-            avFrameIn->data,
-            avFrameIn->linesize,
-            0,
-            avFrameIn->height,
-            avFrameOut->data,
-            avFrameOut->linesize);
-    } else {
+    if (!context) {
         return false;
     }
 
+    // SOLVFX: convert big frames on several threads, one swscale context per horizontal
+    // band (exact: only for formats without vertical chroma subsampling, e.g. ProRes /
+    // DNxHR 4:2:2 / 4:4:4, and without scaling)
+    const AVPixFmtDescriptor* srcDesc = av_pix_fmt_desc_get(srcPixFmt);
+    const AVPixFmtDescriptor* dstDesc = av_pix_fmt_desc_get(dstPixFmt);
+    const int h = avFrameIn->height;
+    unsigned hw = std::thread::hardware_concurrency();
+    int nBands = (int)std::min( 16u, std::max(1u, hw) );
+    nBands = std::min( nBands, h / 64 );
+    const bool banded = srcDesc && dstDesc && (nBands > 1) &&
+                        (srcDesc->log2_chroma_h == 0) && (dstDesc->log2_chroma_h == 0) &&
+                        !(srcDesc->flags & AV_PIX_FMT_FLAG_PAL) && !(srcDesc->flags & AV_PIX_FMT_FLAG_BITSTREAM) &&
+                        (avFrameIn->width == avFrameOut->width) && (avFrameIn->height == avFrameOut->height);
+    if (banded) {
+        const int bandH = (h + nBands - 1) / nBands;
+        if ( (stream->_bandCtxOf != context) || (stream->_bandCtxH != bandH) || ( (int)stream->_bandCtx.size() != nBands ) ) {
+            stream->freeBandCtx();
+            // same colorspace details as the main context
+            int* invTable = nullptr;
+            int* table = nullptr;
+            int srcRange = 0, dstRange = 1, brightness = 0, contrast = 1 << 16, saturation = 1 << 16;
+            const bool haveDetails = sws_getColorspaceDetails(context, &invTable, &srcRange, &table, &dstRange,
+                                                              &brightness, &contrast, &saturation) >= 0;
+            for (int i = 0; i < nBands; ++i) {
+                const int y0 = i * bandH;
+                const int bh = std::min(bandH, h - y0);
+                SwsContext* bc = nullptr;
+                if (bh > 0) {
+                    bc = sws_getContext(avFrameIn->width, bh, srcPixFmt, avFrameOut->width, bh, dstPixFmt,
+                                        SWS_BICUBIC, nullptr, nullptr, nullptr);
+                    if (bc && haveDetails) {
+                        sws_setColorspaceDetails(bc, invTable, srcRange, table, dstRange, brightness, contrast, saturation);
+                    }
+                }
+                stream->_bandCtx.push_back(bc);
+            }
+            stream->_bandCtxOf = context;
+            stream->_bandCtxH = bandH;
+        }
+        bool ok = true;
+        for (int i = 0; i < nBands; ++i) {
+            if ( !stream->_bandCtx[i] && (i * bandH < h) ) {
+                ok = false;
+            }
+        }
+        if (ok) {
+            std::vector<std::thread> threads;
+            threads.reserve(nBands);
+            for (int i = 0; i < nBands; ++i) {
+                const int y0 = i * bandH;
+                const int bh = std::min(bandH, h - y0);
+                if (bh <= 0) {
+                    continue;
+                }
+                SwsContext* bc = stream->_bandCtx[i];
+                threads.emplace_back([=]() {
+                    const uint8_t* src[4] = { nullptr, nullptr, nullptr, nullptr };
+                    uint8_t* dst[4] = { nullptr, nullptr, nullptr, nullptr };
+                    for (int p = 0; p < 4; ++p) {
+                        if (avFrameIn->data[p]) {
+                            src[p] = avFrameIn->data[p] + (std::ptrdiff_t)y0 * avFrameIn->linesize[p];
+                        }
+                        if (avFrameOut->data[p]) {
+                            dst[p] = avFrameOut->data[p] + (std::ptrdiff_t)y0 * avFrameOut->linesize[p];
+                        }
+                    }
+                    sws_scale(bc, src, avFrameIn->linesize, 0, bh, dst, avFrameOut->linesize);
+                });
+            }
+            for (std::size_t i = 0; i < threads.size(); ++i) {
+                threads[i].join();
+            }
+
+            return true;
+        }
+    }
+
+    sws_scale(
+        context,
+        avFrameIn->data,
+        avFrameIn->linesize,
+        0,
+        avFrameIn->height,
+        avFrameOut->data,
+        avFrameOut->linesize);
+
     return true;
 }
 
